{
  "name": "@vanduo-oss/labs",
  "version": "0.1.1",
  "private": true,
  "description": "Vanduo Web Labs \u2014 demo playground for VWL engines and vwl-cbun widgets (hybrid search, AiChat, draw, hex, code editor, music player)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nostromo-618/labs.git"
  },
  "keywords": [
    "vanduo",
    "labs",
    "demo",
    "hybrid-search",
    "ai-chat",
    "model-eval"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:qa": "vite build --mode qa",
    "preview": "vite preview",
    "demo:serve": "vite",
    "index": "node utils/hybrid-search-indexer.mjs",
    "models:fetch": "node utils/fetch-ai-models.mjs",
    "speech:fetch": "node utils/fetch-speech-models.mjs",
    "docs:check": "node utils/check-chat-doc-links.mjs",
    "model-eval": "node utils/model-eval-runner.mjs",
    "lint": "eslint model-eval.js \"utils/**/*.{js,mjs}\" \"src/**/*.{js,mjs}\"",
    "format": "prettier --write \"model-eval.js\" \"utils/**/*.{js,mjs}\" \"src/**/*.{js,mjs,vue,css}\"",
    "format:check": "prettier --check \"model-eval.js\" \"utils/**/*.{js,mjs}\" \"src/**/*.{js,mjs,vue,css}\"",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:unit": "playwright test tests/unit",
    "test:local": "playwright test -c tests/local/playwright.config.ts",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "vite": "8.3.2"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@litert-lm/core": "0.17.1",
    "@vanduo-oss/vd3": "1.7.5",
    "@vanduo-oss/vd3-charts": "1.1.1",
    "@vanduo-oss/vwl-ai-chat": "link:../vwl-ai-chat",
    "@vanduo-oss/vwl-cbun": "link:../vwl-cbun",
    "@vanduo-oss/vwl-hybrid-search": "link:../vwl-hybrid-search",
    "fuse.js": "7.5.0",
    "phonemizer": "1.2.1",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "vue": "3.5.43",
    "@mlc-ai/web-llm": "0.2.85",
    "@vanduo-oss/vwl-hex-earth": "link:../vwl-hex-earth"
  },
  "packageManager": "pnpm@10.34.6",
  "pnpm": {
    "overrides": {
      "adm-zip": "0.6.1",
      "sharp": "0.35.4",
      "nanoid@>=3 <3.3.18": "3.3.18",
      "brace-expansion@>=5 <5.0.12": "5.0.12"
    }
  }
}
